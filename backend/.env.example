# 复制为 backend/.env 后填值；.env 不入库，仓库里只保留本模板
# 【必须】live 模式缺失会启动失败；【可选】不填则该通道/能力自动关闭
MRAG_MODE=live

# 双档模型：fast 跑规划/抽取/评分，strong 跑分析/写作
# fast 用 flash 但关掉思考模式（比换非推理模型更稳）；strong 可用 deepseek-chat
MRAG_FAST_MODEL=openai/deepseek-flash
MRAG_FAST_BASE_URL=
MRAG_FAST_API_KEY=
MRAG_FAST_EXTRA_HEADERS={}
MRAG_FAST_EXTRA_BODY={"thinking":{"type":"disabled"}}
MRAG_STRONG_MODEL=openai/deepseek-chat
MRAG_STRONG_BASE_URL=
MRAG_STRONG_API_KEY=
MRAG_STRONG_EXTRA_HEADERS={}
MRAG_STRONG_EXTRA_BODY=

# R2R 本地知识库
MRAG_R2R_BASE_URL=http://localhost:7272
MRAG_R2R_COLLECTION=demo
# 【可选】本机 docker 栈未开鉴权时留空
MRAG_R2R_API_KEY=
MRAG_RETRIEVER_TOP_K=8
# 检索扇出硬超时：本地 R2R 通常 <1s，联网只是补充
MRAG_RETRIEVAL_TIMEOUT_S=8

# 多源检索：Web
MRAG_WEB_SEARCH=1
MRAG_WEB_SEARCH_TOP_K=3
# ddgs（免 key，易限流）｜bocha（国内，有免费额度）｜tavily（1000 次/月免费）
# 选 bocha/tavily 必须填 MRAG_WEB_API_KEY；调用失败会自动回退 ddgs
MRAG_WEB_PROVIDER=ddgs
MRAG_WEB_API_KEY=
# 联网单次搜索超时；整次联网检索另有 4s 硬截止与失败冷却
MRAG_WEB_SEARCH_TIMEOUT_S=3
# 【可选】出网需代理时填，如 http://127.0.0.1:7890
MRAG_WEB_SEARCH_PROXY=

# 前端跨域（逗号分隔）
MRAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 多源检索：Google Drive 云端网盘（三选一，【可选】通道；当前未配置即自动关闭）
# A. OAuth 刷新令牌（可访问私有网盘，推荐）
MRAG_GDRIVE_CLIENT_ID=
MRAG_GDRIVE_CLIENT_SECRET=
MRAG_GDRIVE_REFRESH_TOKEN=
# B. 服务账号 JSON（填文件路径或整段 JSON；SA 无上传配额，需把文件夹共享给 client_email）
MRAG_GDRIVE_SERVICE_ACCOUNT_JSON=
# C. API key（仅公开共享文件）
MRAG_GDRIVE_API_KEY=
# 限定某个文件夹 / 云端通道条数 / 出网代理
MRAG_GDRIVE_FOLDER_ID=
MRAG_GDRIVE_TOP_K=3
# 【可选】Google 域名直连不通时填本地代理
MRAG_GDRIVE_PROXY=

# 持久化（默认 backend/data/runs.db）
MRAG_DB_PATH=
# 【可选】餐食图片落盘目录（默认 backend/data/uploads；只存文件名进状态）
MRAG_UPLOAD_DIR=

# 【可选】可观测：PUBLIC/SECRET 两把都填才启用 Langfuse 埋点
MRAG_LANGFUSE_PUBLIC_KEY=
MRAG_LANGFUSE_SECRET_KEY=
MRAG_LANGFUSE_HOST=http://localhost:3000

# 【可选】音频解析：不填则 m4a/wav 走本地转写 JSON
MRAG_FUNASR_URL=
